{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Retro Game Store: start",
      "type": "shell",
      "command": "sh",
      "args": [
        "${workspaceFolder}/start.command"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "windows": {
        "command": "cmd",
        "args": [
          "/d",
          "/c",
          "${workspaceFolder}\\start.bat"
        ]
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": [
        {
          "owner": "retro-game-store",
          "pattern": {
            "regexp": "^(.*):(\\d+):\\s+(.*)$",
            "file": 1,
            "line": 2,
            "message": 3
          },
          "background": {
            "activeOnStart": true,
            "beginsPattern": "^RETRO_GAME_STORE_START",
            "endsPattern": "(?:Development Server.*started|^RETRO_GAME_STORE_READY)"
          }
        }
      ],
      "runOptions": {
        "instanceLimit": 1
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
